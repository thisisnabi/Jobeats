{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=jobeats.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jobeats": {
    "PingLogLimit": 100,
    "AlertCheckIntervalSeconds": 30,
    "PruneIntervalHours": 1
  }
}
